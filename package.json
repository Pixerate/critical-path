{
  "name": "critical-path-root",
  "private": true,
  "version": "0.1.2",
  "description": "Headless Project Management System Framework",
  "author": "Jack James",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "eslint packages",
    "dev": "pnpm --recursive --parallel run dev",
    "clean": "pnpm --recursive run clean",
    "docs:dev": "pnpm --filter @critical-path/docs dev",
    "docs:build": "pnpm --filter @critical-path/docs build",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.6",
    "eslint": "^9.39.5",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
