{
  "name": "critical-path-root",
  "private": true,
  "version": "0.1.2",
  "description": "Headless Project Management System Framework",
  "author": "Jack James",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "lint": "pnpm --recursive run lint",
    "dev": "pnpm --recursive --parallel run dev",
    "clean": "pnpm --recursive run clean",
    "docs:dev": "pnpm --filter @critical-path/docs dev",
    "docs:build": "pnpm --filter @critical-path/docs build",
    "changeset": "changeset",
    "version:packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.28.2"
}
