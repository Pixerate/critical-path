{
  "name": "critical-path-root",
  "private": true,
  "version": "0.1.0",
  "description": "Headless Project Management System Framework",
  "author": "Jack James",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "pnpm --recursive run build",
