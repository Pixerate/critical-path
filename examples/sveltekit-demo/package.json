    "@critical-path/server": "workspace:*",
    "@critical-path/svelte": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "svelte": "^5.57.2",
    "typescript": "^6.0.0",
    "vitest": "^3.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "vite": "^8.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
