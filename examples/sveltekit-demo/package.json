{
  "name": "sveltekit-demo",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "start": "node build",
    "test": "vitest run",
    "clean": "rm -rf build .svelte-kit *.tsbuildinfo"
  },
  "dependencies": {
