---
// apps/docs/src/components/FooterSection.astro
---

<footer class="mt-20 border-t border-slate-800/80 py-12 text-slate-400 text-xs">
  <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <img src="/logo.svg" alt="Critical Path" class="w-6 h-6" />
      <span class="font-semibold text-slate-200 text-sm">Critical Path</span>
      <span class="text-slate-600">|</span>
      <span>Crafted by <a href="https://pixerate.com" target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300">Pixerate</a></span>
    </div>

    <!-- Google Cloud & Firebase App Hosting Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-900 border border-slate-800 text-slate-400 font-mono text-[11px]">
      <svg class="w-3.5 h-3.5 text-amber-400 fill-current" viewBox="0 0 24 24">
        <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95C8.08 7.14 9.94 6 12 6c2.62 0 4.88 1.86 5.39 4.43l.3 1.5 1.53.11c1.56.1 2.78 1.41 2.78 2.96 0 1.65-1.35 3-3 3z"/>
      </svg>
      <span>Hosted globally on <strong class="text-slate-300">Google Cloud / Firebase Hosting</strong></span>
    </div>

    <div class="flex items-center gap-4 text-slate-400">
      <a href="/getting-started/quick-start/" class="hover:text-slate-200 transition-colors">Quick Start</a>
      <a href="/core/data-model/" class="hover:text-slate-200 transition-colors">Data Model</a>
      <a href="https://github.com/Pixerate/Critical-Path" target="_blank" rel="noopener noreferrer" class="hover:text-slate-200 transition-colors">GitHub</a>
      <span class="text-slate-600">&bull;</span>
      <span>MIT Licensed</span>
    </div>
  </div>
</footer>
