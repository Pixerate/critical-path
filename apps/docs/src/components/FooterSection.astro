---
// apps/docs/src/components/FooterSection.astro
---

<footer class="mt-16 border-t border-slate-200 dark:border-slate-800/80 py-10 text-slate-600 dark:text-slate-400 text-xs">
  <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <img src="/logo.svg" alt="Critical Path" class="w-6 h-6" />
      <span class="font-semibold text-slate-900 dark:text-slate-200 text-sm">Critical Path</span>
      <span class="text-slate-300 dark:text-slate-700">|</span>
      <span>Crafted by <a href="https://pixerate.com" target="_blank" rel="noopener noreferrer" class="text-sky-600 dark:text-sky-400 hover:text-sky-700 dark:hover:text-sky-300">Pixerate</a></span>
    </div>

    <div class="flex items-center gap-4 text-slate-600 dark:text-slate-400">
      <a href="/getting-started/quick-start/" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Quick Start</a>
      <a href="/core/data-model/" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Data Model</a>
      <a href="https://github.com/Pixerate/Critical-Path" target="_blank" rel="noopener noreferrer" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">GitHub</a>
      <span class="text-slate-300 dark:text-slate-700">&bull;</span>
      <span>MIT Licensed</span>
    </div>
  </div>
</footer>
