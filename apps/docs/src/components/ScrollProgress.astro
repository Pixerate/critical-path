---
// apps/docs/src/components/ScrollProgress.astro
---

<div id="scroll-progress" class="scroll-progress-bar" aria-hidden="true"></div>

<!-- Floating Back to Top / Scroll Percentage Pill -->
<button
  id="scroll-to-top"
  class="fixed bottom-6 right-6 z-50 flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/90 dark:bg-slate-900/90 border border-slate-300 dark:border-slate-700 shadow-md dark:shadow-xl backdrop-blur-md text-xs font-medium text-slate-700 dark:text-slate-300 hover:text-sky-600 dark:hover:text-sky-400 hover:border-sky-500/50 transition-all duration-300 opacity-0 pointer-events-none translate-y-3 cursor-pointer"
  aria-label="Scroll to top"
>
  <svg class="w-3.5 h-3.5 text-sky-600 dark:text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
  </svg>
  <span id="scroll-percent" class="font-mono text-xs font-semibold">0%</span>
</button>

<style>
  .scroll-progress-bar {
    position: fixed;
    top: var(--sl-nav-height, 3.5rem);
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #0284c7 0%, #6366f1 50%, #ec4899 100%);
    box-shadow: 0 0 10px rgba(99, 102, 241, 0.7);
    transform-origin: 0% 50%;
    transform: scaleX(0);
    z-index: 50;
    pointer-events: none;
    transition: transform 0.04s linear;
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-progress-bar,
    #scroll-to-top {
      display: none !important;
    }
  }
</style>

<script>
  function initScrollExperience() {
    const progressBar = document.getElementById('scroll-progress');
    const scrollTopBtn = document.getElementById('scroll-to-top');
    const scrollPercent = document.getElementById('scroll-percent');
    const header = document.querySelector('header.header');
    const parallaxElements = document.querySelectorAll<HTMLElement>('.parallax-element');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 1. Scroll-reveal Observer with Staggering
    if (!reducedMotion) {
      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              revealObserver.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
      );

      // Observe all section containers
      document.querySelectorAll('.scroll-reveal').forEach((el) => {
        revealObserver.observe(el);
      });

      // Observe cards and apply stagger delay
      document.querySelectorAll('.scroll-reveal-card').forEach((el, idx) => {
        const staggerDelay = (idx % 3) * 100;
        (el as HTMLElement).style.transitionDelay = `${staggerDelay}ms`;
        revealObserver.observe(el);
      });
    } else {
      // If prefers-reduced-motion is enabled, make everything visible immediately
      document.querySelectorAll('.scroll-reveal, .scroll-reveal-card').forEach((el) => {
        el.classList.add('is-visible');
      });
    }

    // 2. High-performance RAF Scroll Loop
    let ticking = false;
    const updateScrollMetrics = () => {
      const scrollY = window.scrollY;
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollable > 0 ? Math.min(Math.max(scrollY / scrollable, 0), 1) : 0;

      // Update progress bar
      if (progressBar && !reducedMotion) {
        progressBar.style.transform = `scaleX(${progress})`;
      }

      // Update floating back to top button
      if (scrollTopBtn && scrollPercent) {
        scrollPercent.textContent = `${Math.round(progress * 100)}%`;
        if (scrollY > 300) {
          scrollTopBtn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-3');
          scrollTopBtn.classList.add('opacity-100', 'pointer-events-auto', 'translate-y-0');
        } else {
          scrollTopBtn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-3');
          scrollTopBtn.classList.remove('opacity-100', 'pointer-events-auto', 'translate-y-0');
        }
      }

      // Update Header Elevation Shadow
      if (header) {
        if (scrollY > 20) {
          header.classList.add('header-scrolled');
        } else {
          header.classList.remove('header-scrolled');
        }
      }

      // Parallax Shifts for Ambient Orbs
      if (parallaxElements.length > 0 && !reducedMotion) {
        parallaxElements.forEach((el) => {
          const speed = parseFloat(el.getAttribute('data-parallax-speed') || '0.15');
          const yOffset = scrollY * speed;
          el.style.transform = `translate3d(0, ${yOffset}px, 0)`;
        });
      }

      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(updateScrollMetrics);
        ticking = true;
      }
    }, { passive: true });

    // Click handler for Back to Top
    if (scrollTopBtn) {
      scrollTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Initial run
    updateScrollMetrics();
  }

  // Initialize on load and re-initialize on view transitions if any
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollExperience);
  } else {
    initScrollExperience();
  }
  document.addEventListener('astro:page-load', initScrollExperience);
</script>
