{
  "name": "@critical-path/core",
  "version": "0.36.1",
  "description": "Core headless domain engine, plugin architecture, and data stores for Critical Path",
  "author": "Jack James",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/critical-path.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ]
}
