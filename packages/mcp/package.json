{
  "name": "@critical-path/mcp",
  "version": "0.16.1",
  "description": "Standard Model Context Protocol (MCP) server and client-side WebMCP support for Critical Path",
  "author": "Jack James",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/critical-path.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "critical-path-mcp": "./dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@critical-path/client": "workspace:*",
    "@critical-path/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ]
}
