{
  "name": "@critical-path/mcp",
  "version": "0.20.0",
  "description": "Model Context Protocol (MCP) server, client-side WebMCP tools and agent skills for Critical Path",
  "author": "Jack James",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/critical-path.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "critical-path-mcp": "./dist/bin/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "import": "./dist/web/index.js"
    },
    "./skills/*": "./skills/*"
  },
  "scripts": {
    "build": "node scripts/generate-skills.mjs && tsc --build",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "generate:skills": "node scripts/generate-skills.mjs",
    "eval:tools": "node evals/tool-selection.mjs"
  },
  "dependencies": {
    "@critical-path/client": "workspace:*",
    "@critical-path/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md",
    "!dist/**/*.test.*"
  ]
}
