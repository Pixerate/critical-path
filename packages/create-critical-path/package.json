{
  "name": "create-critical-path",
  "version": "0.1.2",
  "description": "CLI scaffolding tool for bootstrapping Next.js and SvelteKit applications with Critical Path headless project management",
  "author": "Jack James",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "create-critical-path": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc --build && node scripts/copy-templates.mjs",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pixerate/critical-path.git",
    "directory": "packages/create-critical-path"
  }
}
